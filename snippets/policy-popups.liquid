  <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl flex flex-col max-h-[85vh] overflow-hidden transform scale-95 transition-transform duration-200" id="pawash-policy-content-box">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-stone-200">
      <h2 id="pawash-policy-title" class="text-lg sm:text-xl font-bold text-stone-900">Policy</h2>
      <button type="button" class="text-stone-400 hover:text-stone-700 transition rounded-lg p-1 hover:bg-stone-100" onclick="closePaWashPolicy()">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
