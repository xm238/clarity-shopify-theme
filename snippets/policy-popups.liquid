</div>

<script>
  const pawashModal = document.getElementById('pawash-policy-modal');
  const pawashModalBox = document.getElementById('pawash-policy-content-box');
  const pawashModalTitle = document.getElementById('pawash-policy-title');
  const pawashModalBody = document.getElementById('pawash-policy-body');

  function openPaWashPolicy(e, type, title) {
    if (e) e.preventDefault();
    const content = document.getElementById('policy-data-' + type);
    if (!content) return;
    
    pawashModalTitle.innerText = title;
    pawashModalBody.innerHTML = content.innerHTML;
    
    pawashModal.classList.remove('hidden');
    pawashModal.classList.add('flex');
    
    // small delay for transition
    setTimeout(() => {
      pawashModal.classList.remove('opacity-0');
      pawashModal.classList.add('opacity-100');
      pawashModalBox.classList.remove('scale-95');
      pawashModalBox.classList.add('scale-100');
    }, 10);
  }

  function closePaWashPolicy() {
    pawashModal.classList.remove('opacity-100');
    pawashModal.classList.add('opacity-0');
    pawashModalBox.classList.remove('scale-100');
    pawashModalBox.classList.add('scale-95');
    
    setTimeout(() => {
      pawashModal.classList.remove('flex');
      pawashModal.classList.add('hidden');
    }, 200); 
  }

  // Close on backdrop click
  pawashModal.addEventListener('click', (e) => {
    if (e.target === pawashModal) closePaWashPolicy();
  });
</script>
