{% stylesheet %}
  .pawely-hiw {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background-color: var(--p-cream, #FBF9F5);
    border-bottom: 1px solid var(--p-stone-200, #E7E5E4);
    font-family: 'Inter', system-ui, sans-serif;
  }

  .pawely-hiw__inner {
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .pawely-hiw__header {
    text-align: center;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3.5rem;
  }

  .pawely-hiw__heading {
    font-size: 2rem;
    font-weight: 800;
    color: var(--p-dark, #16281E);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .pawely-hiw__subheading {
    font-size: 1.0625rem;
    color: var(--p-stone-500, #78716C);
    line-height: 1.6;
    margin: 0;
  }

  .pawely-hiw__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
  }

  .pawely-hiw__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .pawely-hiw__step-image-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .pawely-hiw__step-image-circle {
    width: 9rem;
    height: 9rem;
    border-radius: 9999px;
    overflow: hidden;
    border: 4px solid #fff;
    box-shadow: 0 8px 32px rgba(22, 40, 30, 0.15);
    background-color: var(--p-stone-100, #F5F5F4);
    flex-shrink: 0;
  }

  .pawely-hiw__step-image-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pawely-hiw__step-badge {
    position: absolute;
    top: -0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background-color: var(--p-green, #2A5934);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(42, 89, 52, 0.35);
    border: 2px solid #fff;
    z-index: 1;
  }

  .pawely-hiw__step-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pawely-hiw__step-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--p-dark, #16281E);
    margin: 0;
  }

  .pawely-hiw__step-desc {
    font-size: 0.9rem;
    color: var(--p-stone-500, #78716C);
    line-height: 1.55;
    margin: 0;
    max-width: 16rem;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (min-width: 640px) {
    .pawely-hiw {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }

    .pawely-hiw__inner {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .pawely-hiw__heading {
      font-size: 2.25rem;
    }
  }

  @media screen and (min-width: 768px) {
    .pawely-hiw__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }

    .pawely-hiw__inner {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
{% endstylesheet %}

<section class="pawely-hiw" id="pawely-hiw-{{ section.id }}">
  <div class="pawely-hiw__inner">

    <!-- Section Header -->
    <div class="pawely-hiw__header">
      <h2 class="pawely-hiw__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="pawely-hiw__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <!-- Steps -->
    {% if section.blocks.size > 0 %}
      <div class="pawely-hiw__steps">
        {% for block in section.blocks %}
          {%- liquid
            assign step_index = forloop.index
            case step_index
              when 1
                assign default_img = 'https://lh3.googleusercontent.com/aida-public/AB6AXuAB-k9a1_cWAegs6gp4hTvPaK8p6RkfsuIe9kKWjbd4-02Wdi9UsmkGU_JVBT8kaU2nL-qp8963Hxkqyrbkjql6AyP0hkG43KuDIhDVs_nvO8LM3Zq-UxxxtIBazifTvg7J2KUfdV9BVAJj6JHhfvlJSVWOH6qGeAZ6AlncK8UyUcUR_ziOnm_ti7DJ7U9HEIdSiB9mD044Sga9zW0gkHGntD0dLVvira_fCSZxGR3QaZR5wgExIw8eFw'
              when 2
                assign default_img = 'https://lh3.googleusercontent.com/aida-public/AB6AXuD3fb5o6oYkBTpoum3ZKfscQZwXJXvglvd7wS7-OwjOPMqmfj1YtN-g-2GCo4mM0BFrACQpSsY0MrEfRDWP64hUzDgisq7lo2mzrCAOhIc5DhfuhlsAyJt4ej0NMKwG-enx8HVm9QpwcCHoRuVki78Q1df__XZmGfdUwbJl0fsNm1zMCyIGOYZXoxfL0scopykhCPepgsCyOyYtdm_hljLqlaMYcrbT7qfyPHz88X0dyOcj2uvo1OVRYw'
              when 3
                assign default_img = 'https://lh3.googleusercontent.com/aida-public/AB6AXuA-qu9z5Vt10Wt6hOr0kj7vsdytTcmVrBk8zvRtA7JbYu6d2YH5SP2xv_GlbnKMFfk6riTUrTnLJzP8vUEVZEztLV2mIsMVQXTdV6kWV7Nu6EZcChto1mz0NJps6nvnYbdC24yySsCROVGHExyogS2YEms2_cWmrbj7Gdwqad2WFIjsMeO9hkQy9ESfz-ExPQyvtBeuUatap5WXOvS6FdayQ4H-Zt7yQkF0wlYj8E7m7vrOB6axs4_ytw'
              else
                assign default_img = ''
            endcase
          -%}
          <div class="pawely-hiw__step" {{ block.shopify_attributes }}>
            <div class="pawely-hiw__step-image-wrap">
              <span class="pawely-hiw__step-badge" aria-hidden="true">{{ block.settings.step_number }}</span>
              <div class="pawely-hiw__step-image-circle">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 400 | image_tag:
                    alt: block.settings.title,
                    loading: 'lazy',
                    width: block.settings.image.width,
                    height: block.settings.image.height
                  }}
                {% elsif default_img != blank %}
                  <img
                    src="{{ default_img }}"
                    alt="{{ block.settings.title }}"
                    loading="lazy"
                    width="288"
                    height="288"
                  >
                {% endif %}
              </div>
            </div>
            <div class="pawely-hiw__step-body">
              <p class="pawely-hiw__step-title">{{ block.settings.title }}</p>
              {% if block.settings.description != blank %}
                <p class="pawely-hiw__step-desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Pawely How It Works",
  "tag": "div",
  "class": "pawely-hiw-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Clean in 3 simple steps."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Connect"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Attach the Pawely sprayer to any standard garden hose in seconds."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pawely How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "1",
            "title": "Connect",
            "description": "Attach the Pawely sprayer to any standard garden hose in seconds—no tools needed."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "2",
            "title": "Wash",
            "description": "Spray, lather, and scrub your dog with the built-in soap dispenser and silicone bristles."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "3",
            "title": "Enjoy",
            "description": "Rinse off and enjoy a clean, happy dog—without the mess or the stress."
          }
        }
      ]
    }
  ]
}
{% endschema %}
