<section class="py-10 sm:py-12 bg-brand-cream border-b border-stone-200/50">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-start lg:items-center gap-8 lg:gap-16">
      
      <!-- Header -->
      <div class="lg:w-1/4 text-left shrink-0">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight mb-1">{{ section.settings.heading }}</h2>
        <p class="text-sm text-stone-600 font-medium">{{ section.settings.subheading }}</p>
      </div>
      
      <!-- Steps Grid -->
      <div class="lg:w-3/4 w-full">
        <div class="!grid grid-cols-3 gap-6 lg:gap-10">
          
          <!-- Step 1 -->
          <div class="flex flex-col items-center text-center">
            <div class="w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden mb-4 bg-stone-200 relative">
              <img width="800" height="800" alt="Step 1 Connect Pawely sprayer" class="w-full h-full object-cover" src="{{ 'step_1_connect.jpg' | asset_url }}">
            </div>
            <div class="flex flex-col items-center">
              <div class="flex items-center gap-2 mb-1 justify-center">
                <span class="w-8 h-8 rounded-full bg-[#0A361A] text-white text-sm font-bold flex items-center justify-center shrink-0">1</span>
                <h3 class="font-bold text-stone-900 text-lg">Connect</h3>
              </div>
              <p class="text-xs text-stone-600">Fits any standard hose.</p>
            </div>
          </div>
          
          <!-- Step 2 -->
          <div class="flex flex-col items-center text-center">
            <div class="w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden mb-4 bg-stone-200 relative">
              <img width="800" height="800" alt="Step 2 Wash and lather pet" class="w-full h-full object-cover" src="{{ 'step_2_wash.jpg' | asset_url }}">
            </div>
            <div class="flex flex-col items-center">
              <div class="flex items-center gap-2 mb-1 justify-center">
                <span class="w-8 h-8 rounded-full bg-[#0A361A] text-white text-sm font-bold flex items-center justify-center shrink-0">2</span>
                <h3 class="font-bold text-stone-900 text-lg">Wash</h3>
              </div>
              <p class="text-xs text-stone-600">Rinse and scrub with ease.</p>
            </div>
          </div>
          
          <!-- Step 3 -->
          <div class="flex flex-col items-center text-center">
            <div class="w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden mb-4 bg-stone-200 relative">
              <img width="800" height="800" alt="Step 3 Happy clean dog" class="w-full h-full object-cover" src="{{ 'step_3_enjoy.jpg' | asset_url }}">
            </div>
            <div class="flex flex-col items-center">
              <div class="flex items-center gap-2 mb-1 justify-center">
                <span class="w-8 h-8 rounded-full bg-[#0A361A] text-white text-sm font-bold flex items-center justify-center shrink-0">3</span>
                <h3 class="font-bold text-stone-900 text-lg">Enjoy</h3>
              </div>
              <p class="text-xs text-stone-600">A cleaner, happier dog.</p>
            </div>
          </div>
          
        </div>
      </div>
    </div>
</div>
</section>

{% schema %}
{
  "name": "PawJet™ How It Works",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clean in 3 simple steps."
    }
  ],
  "presets": [
    {
      "name": "PawJet™ How It Works"
    }
  ]
}
{% endschema %}
