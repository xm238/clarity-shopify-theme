<section class="py-10 sm:py-12 bg-white text-stone-900 overflow-hidden relative border-b border-stone-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-center">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" 
           alt="{{ section.settings.image.alt | default: 'Before and After' | escape }}" 
           class="w-full max-w-[800px] h-auto rounded-3xl shadow-2xl border border-stone-200 object-cover"
           loading="lazy">
    {% else %}
      <div class="w-full max-w-[800px] aspect-square bg-stone-100 flex flex-col items-center justify-center rounded-3xl shadow-xl border border-stone-200 text-stone-400">
        <svg class="w-12 h-12 mb-3 text-stone-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        <span class="text-sm font-medium">Please upload the Before/After image in the Theme Editor</span>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PaWash™ Transformation",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Before & After Image"
    }
  ],
  "presets": [
    {
      "name": "PaWash™ Transformation"
    }
  ]
}
{% endschema %}
