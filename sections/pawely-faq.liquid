{% comment %} pawely-faq.liquid {% endcomment %}

<style>
  .pawely-faq-section {
    padding: 4rem 1.25rem;
    border-bottom: 1px solid #E7E5E4;
    font-family: 'Inter', system-ui, sans-serif;
    background-color: {{ section.settings.bg_color }};
  }

  .pawely-faq-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .pawely-faq-heading {
    font-size: 1.875rem;
    font-weight: 700;
    color: #1C1917;
    text-align: center;
    margin: 0 0 2.5rem 0;
    line-height: 1.2;
  }

  .pawely-faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .pawely-faq-details {
    background-color: rgba(251, 249, 245, 0.3);
    border: 1px solid #E7E5E4;
    border-radius: 0.75rem;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .pawely-faq-details:hover {
    border-color: #A8A29E;
  }

  .pawely-faq-details[open] {
    border-color: #A8A29E;
  }

  .pawely-faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 0.875rem;
    color: #1C1917;
    line-height: 1.4;
    -webkit-user-select: none;
    user-select: none;
  }

  .pawely-faq-summary::-webkit-details-marker {
    display: none;
  }

  .pawely-faq-summary:focus-visible {
    outline: 2px solid #38A169;
    outline-offset: -2px;
    border-radius: 0.75rem;
  }

  .pawely-faq-chevron {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    color: #78716C;
    transition: transform 0.25s ease;
  }

  .pawely-faq-details[open] .pawely-faq-chevron {
    transform: rotate(180deg);
  }

  .pawely-faq-answer {
    padding: 0 1rem 1rem 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #57534E;
    margin: 0;
    border-top: 1px solid #E7E5E4;
    padding-top: 0.75rem;
  }

  @media (min-width: 768px) {
    .pawely-faq-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pawely-faq-heading {
      font-size: 2.25rem;
    }
  }

  @media (min-width: 1024px) {
    .pawely-faq-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<div id="faq" class="pawely-faq-section">
  <div class="pawely-faq-inner">

    <h2 class="pawely-faq-heading">{{ section.settings.heading | escape }}</h2>

    <div class="pawely-faq-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <details class="pawely-faq-details" {{ block.shopify_attributes }}>
            <summary class="pawely-faq-summary">
              <span>{{ block.settings.question | escape }}</span>
              <svg class="pawely-faq-chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="pawely-faq-answer">{{ block.settings.answer | escape }}</p>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Pawely FAQ",
  "tag": "section",
  "class": "pawely-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Your answer here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pawely FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Does it fit my garden hose?",
            "answer": "Yes! Pawely connects to any standard garden hose with a universal ¾-inch thread. No adapters or special tools required — just screw it on and you're ready to go."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I use my own shampoo?",
            "answer": "Absolutely. The built-in shampoo dispenser is compatible with any liquid dog shampoo or conditioner. Simply fill the reservoir and the system mixes it automatically at the right concentration."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe for all dog breeds?",
            "answer": "Pawely is designed for dogs of all sizes and coat types, from tiny Chihuahuas to large Great Danes. The gentle spray pressure and warm-water flow are safe and comfortable for every breed."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I clean it?",
            "answer": "Cleaning is simple — after each use, flush the system with clean water for 30 seconds. The detachable nozzle and reservoir can be rinsed or placed in the top rack of a dishwasher."
          }
        }
      ]
    }
  ]
}
{% endschema %}
