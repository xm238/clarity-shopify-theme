{% assign bg_image_url = "https://lh3.googleusercontent.com/aida-public/AB6AXuDB3fSZLyYNuEkr-pEF6FDToCWiCojaXQbfSsAy6Mxmq1mh-jBAEezqS3BQA84QwGEwjt-h8prHylNerjnz8TXYb7QUtcZpwtcoVduEOZOdCkzdOYRdCNN3qI9P3_MtgvP5-m6liMplv6Apz2qgsrrrd-3Fz50XTAaK1WSPvMFWmAbCEY62HYxxgZF9De8hrJHRGPvqY1F8kRTNPbErgvHBZJN0B8CLpMz1QveFHqAZ2VtDxxJxqohBXA" %}
{% if section.settings.hero_image != blank %}
  {% assign bg_image_url = section.settings.hero_image | image_url: width: 2400 %}
{% endif %}
<section class="relative overflow-hidden pt-32 pb-16 lg:pt-40 lg:pb-24 min-h-[600px] lg:min-h-[750px] flex items-center bg-brand-cream border-b border-stone-200/50">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img src="{{ bg_image_url }}" alt="Hero Background" class="w-full h-full object-cover object-center lg:object-right">
  </div>
  <!-- Gradient Overlay for readability -->
  <div class="absolute inset-0 z-0 bg-gradient-to-r from-brand-cream via-brand-cream/80 to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="max-w-xl">
      <span class="inline-block text-xs font-bold tracking-widest text-stone-600 uppercase mb-3">
        {{ section.settings.eyebrow }}
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-brand-dark tracking-tight leading-[1.08] mb-5">
        {{ section.settings.heading }}
      </h1>
      <p class="text-base sm:text-lg text-stone-700 max-w-md mb-8 leading-relaxed font-medium">
        {{ section.settings.description }}
      </p>
      
      <!-- Hero CTA Button -->
      <div class="mb-10">
        <a class="inline-flex items-center justify-center gap-2 font-semibold text-sm px-7 py-3.5 rounded-full transition duration-200 shadow-md hover:opacity-90" style="background-color: #16281E !important; color: white !important;" href="{{ section.settings.cta_link }}">
          <span class="">{{ section.settings.cta_label }}</span>
          <span class="text-base font-bold">→</span>
        </a>
      </div>
      
      <!-- Value Props List -->
      <div class="flex items-center gap-6 pt-6">
        <div class="flex flex-col items-center text-center">
          <svg class="w-5 h-5 text-stone-800 mb-1.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="text-[11px] font-semibold text-stone-800 leading-tight">Easy to Use</span>
        </div>
        <div class="flex flex-col items-center text-center">
          <svg class="w-5 h-5 text-stone-800 mb-1.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="text-[11px] font-semibold text-stone-800 leading-tight">Gentle &amp; Safe</span>
        </div>
        <div class="flex flex-col items-center text-center">
          <svg class="w-5 h-5 text-stone-800 mb-1.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="text-[11px] font-semibold text-stone-800 leading-tight">Worldwide<br>Shipping</span>
        </div>
      </div>
    </div>
    
    <!-- Handwritten Script Tag on right side of image -->
    <div class="absolute bottom-10 right-4 lg:bottom-32 lg:right-12 text-white text-right drop-shadow-md select-none hidden sm:block">
      <p class="font-handwriting text-3xl sm:text-4xl leading-tight">Happy dogs<br>cleaner days ♡</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pawely Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Bath Time, Made Easier"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading HTML",
      "default": "A cleaner dog.<br>A happier you."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Rinse, scrub, and wash your dog in one simple tool. Turns any garden hose into a powerful pet shower."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Pawely Hero"
    }
  ]
}
{% endschema %}
