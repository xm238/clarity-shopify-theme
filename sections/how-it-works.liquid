{% comment %}
  How It Works Section
  Renders a calm, spacious 3-step process section with left-side heading, circular images, and green number badges.
{% endcomment %}

<div
  class="how-it-works color-{{ section.settings.color_scheme }}"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    
    {% comment %} Left-aligned Header Area {% endcomment %}
    <div class="how-it-works__header">
      {% if section.settings.eyebrow != blank %}
        <span class="hero-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="how-it-works__heading h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="how-it-works__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    {% comment %} Numbered Steps List {% endcomment %}
    {% if section.blocks.size > 0 %}
      <ol class="how-it-works__steps-list" role="list">
        {% for block in section.blocks %}
          <li class="how-it-works__step-item" {{ block.shopify_attributes }}>
            
            {% comment %} Circular Image & Green Number Badge Container {% endcomment %}
            <div class="how-it-works__image-container">
              {% if block.settings.step_number != blank %}
                <span class="how-it-works__number-badge" aria-hidden="true">
                  {{ block.settings.step_number | escape }}
                </span>
              {% endif %}

              <div class="how-it-works__image-frame">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '180, 360, 600',
                      class: 'how-it-works__image',
                      alt: block.settings.title | default: section.settings.heading | escape
                  }}
                {% else %}
                  <div class="how-it-works__placeholder">
                    {% assign placeholder_num = forloop.index | modulo: 3 | plus: 1 %}
                    {{ 'product-' | append: placeholder_num | placeholder_svg_tag: 'how-it-works__placeholder-svg' }}
                  </div>
                {% endif %}
              </div>
            </div>

            {% comment %} Step Text Content {% endcomment %}
            <div class="how-it-works__step-content">
              {% if block.settings.title != blank %}
                <h3 class="how-it-works__step-title h5">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="how-it-works__step-desc">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>

          </li>
        {% endfor %}
      </ol>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .how-it-works {
    padding-top: var(--padding-top, 48px);
    padding-bottom: var(--padding-bottom, 48px);
  }

  .how-it-works__header {
    max-width: 600px;
    margin-block-end: 3rem;
  }

  .how-it-works__heading {
    margin-block-start: 0.5rem;
    margin-block-end: 0.75rem;
    color: var(--color-charcoal-heading, #161C16);
    line-height: 1.2;
  }

  .how-it-works__description {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-charcoal-text, #2B302B);
    opacity: 0.9;
  }

  .how-it-works__steps-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    list-style: none;
    padding: 0;
    margin: 0;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .how-it-works__step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .how-it-works__image-container {
    position: relative;
    width: 180px;
    height: 180px;
    margin-block-end: 1.5rem;
  }

  .how-it-works__number-badge {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--color-deep-green-action, #1E3A2B);
    color: #FAF8F5;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(24, 38, 28, 0.15);
    z-index: 2;
    border: 2px solid var(--color-warm-base, #FAF8F5);
  }

  .how-it-works__image-frame {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-warm-base, #FAF8F5);
    border: 2px solid var(--color-soft-border-neutral, #E2DFD7);
    box-shadow: var(--shadow-restrained-card, 0 4px 20px -2px rgba(24, 38, 28, 0.05));
  }

  .how-it-works__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out-cubic, ease);
  }

  .how-it-works__step-item:hover .how-it-works__image {
    transform: scale(1.04);
  }

  .how-it-works__placeholder {
    width: 100%;
    height: 100%;
    background-color: #E8EFE9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .how-it-works__placeholder-svg {
    width: 45%;
    height: 45%;
    opacity: 0.4;
  }

  .how-it-works__step-content {
    max-width: 280px;
  }

  .how-it-works__step-title {
    margin-block-start: 0;
    margin-block-end: 0.4rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-charcoal-heading, #161C16);
  }

  .how-it-works__step-desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-charcoal-text, #2B302B);
    opacity: 0.88;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How It Works",
  "class": "how-it-works-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "SIMPLE 3-STEP PROCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Supporting Description",
      "default": "Effortless, soothing bath times for your pet in three simple steps."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Attach & Fill"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Explanation",
          "default": "Connect to standard hose and add your favorite shampoo into the built-in reservoir."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "title": "Attach & Fill",
            "description": "Connect to standard hose and add your favorite shampoo into the built-in reservoir."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "title": "Select Spray Mode",
            "description": "Toggle seamlessly between gentle rinse, deep lather, and soothing massage settings."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "title": "Serene Cleanse",
            "description": "Gently wash your pet while the soft rubber pins massage away dirt and loose fur."
          }
        }
      ]
    }
  ]
}
{% endschema %}
