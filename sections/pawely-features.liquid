<section class="py-16 sm:py-20 bg-stone-50/60 border-b border-stone-200/50">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="!grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
<!-- Left: Product Cutout Image -->
<div class="lg:col-span-4 flex justify-center">
<div class="relative w-64 h-64 sm:w-80 sm:h-80 flex items-center justify-center p-4">
{% if section.settings.product_image != blank %}
  <img width="800" height="800" alt="Pawely Dog Shower Sprayer with built-in soap dispenser" class="w-full h-full object-contain filter drop-shadow-2xl hover:scale-105 transition-transform duration-300 rounded-2xl" src="{{ section.settings.product_image | image_url: width: 800 }}">
{% else %}
  <img width="800" height="800" alt="Pawely Dog Shower Sprayer with built-in soap dispenser" class="w-full h-full object-contain filter drop-shadow-2xl hover:scale-105 transition-transform duration-300 rounded-2xl" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkNcWn-LHezFJQQQnPqc-Mnujf3lrhuYULLvEFnCrxTsuz3_-Oln5pPjkNZRHDqE2DlDB9HdqztBtf_EIofkQA_pR5ivADuz0cyA_Kc6VQVTRJv8kSQI520QtQWggjMsnqbjaHZy1TIEIf6UCAWfG9Ulam8JR604N7A57r3TuEIfkagTO7vKnh6Rfa5gXOKsJCd6AXKEHSfHS1qNVvktnLdmbiXm9STiBciM3UUos_tHxlpheNYxkkFw">
{% endif %}
</div>
</div>
<!-- Right Content: Copy & 4-Grid Features -->
<div class="lg:col-span-8">
<div class="max-w-xl mb-10">
<span class="text-xs font-bold uppercase tracking-widest text-stone-500 block mb-2">{{ section.settings.eyebrow }}</span>
<h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight mb-3">{{ section.settings.heading }}</h2>
<p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-6">
                {{ section.settings.description }}
              </p>
<a class="inline-flex items-center gap-2 bg-brand-dark hover:bg-brand-green text-white text-xs sm:text-sm font-semibold px-6 py-3 rounded-full transition" href="{{ section.settings.cta_link }}">
<span class="">{{ section.settings.cta_label }}</span>
<span class="">→</span>
</a>
</div>
<!-- Feature 4-Item List -->
<div class="!grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-stone-200">
<!-- Feature 1 -->
<div class="flex items-start gap-4">
<div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center flex-shrink-0 text-brand-green">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<path d="M12 3v1m0 16v1m8.66-10h-1M4.34 11H3.34m14.8 6.2l-.7-.7M6.56 7.06l-.7-.7m12.74 0l-.7.7M6.56 16.94l-.7.7M12 7a5 5 0 100 10 5 5 0 000-10z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<div>
<h3 class="text-sm font-bold text-stone-900 mb-1">Powerful Rinse</h3>
<p class="text-xs text-stone-500 leading-relaxed">Cleans deep with steady water pressure.</p>
</div>
</div>
<!-- Feature 2 -->
<div class="flex items-start gap-4">
<div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center flex-shrink-0 text-brand-green">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<circle cx="8" cy="8" r="3"></circle>
<circle cx="16" cy="7" r="2"></circle>
<circle cx="14" cy="15" r="4"></circle>
</svg>
</div>
<div>
<h3 class="text-sm font-bold text-stone-900 mb-1">Built-in Soap Dispenser</h3>
<p class="text-xs text-stone-500 leading-relaxed">Mixes soap automatically for the perfect clean.</p>
</div>
</div>
<!-- Feature 3 -->
<div class="flex items-start gap-4">
<div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center flex-shrink-0 text-brand-green">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<path d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<div>
<h3 class="text-sm font-bold text-stone-900 mb-1">Gentle Scrubber</h3>
<p class="text-xs text-stone-500 leading-relaxed">Helps remove dirt and loose fur.</p>
</div>
</div>
<!-- Feature 4 -->
<div class="flex items-start gap-4">
<div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center flex-shrink-0 text-brand-green">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" stroke-linecap="round" stroke-linejoin="round"></path>
<path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<div>
<h3 class="text-sm font-bold text-stone-900 mb-1">Fits Any Hose</h3>
<p class="text-xs text-stone-500 leading-relaxed">Works with standard garden &amp; shower hoses.</p>
</div>
</div>
</div>
</div>
</div>
</div>
</section>

{% schema %}
{
  "name": "Pawely Features",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "All-in-One Design"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spray. Scrub. Clean."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The Pawely dog shower sprayer combines water pressure with a built-in soap dispenser to make bath time faster, easier, and more effective."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Get Yours Today"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    }
  ],
  "presets": [
    {
      "name": "Pawely Features"
    }
  ]
}
{% endschema %}
