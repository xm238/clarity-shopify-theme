{% stylesheet %}
  .pawely-features {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background-color: rgba(250, 250, 249, 0.6);
    border-bottom: 1px solid var(--p-stone-200, #E7E5E4);
    font-family: 'Inter', system-ui, sans-serif;
  }

  .pawely-features__inner {
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .pawely-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .pawely-features__image-col {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .pawely-features__product-image {
    width: 18rem;
    height: 18rem;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 12px 32px rgba(22, 40, 30, 0.15));
    border-radius: 1rem;
  }

  .pawely-features__content-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pawely-features__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-accent, #38A169);
    background-color: rgba(56, 161, 105, 0.1);
    border: 1px solid rgba(56, 161, 105, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    width: fit-content;
  }

  .pawely-features__heading {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--p-dark, #16281E);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .pawely-features__description {
    font-size: 1rem;
    color: var(--p-stone-600, #57534E);
    line-height: 1.65;
    margin: 0;
  }

  .pawely-features__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background-color: var(--p-dark, #16281E);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    transition: background-color 0.2s ease, transform 0.15s ease;
    width: fit-content;
  }

  .pawely-features__cta:hover {
    background-color: var(--p-green, #2A5934);
    transform: translateY(-1px);
  }

  .pawely-features__feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .pawely-features__feature-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .pawely-features__feature-icon-wrap {
    width: 2.5rem;
    height: 2.5rem;
    background-color: #ECFDF5;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pawely-features__feature-icon-wrap svg {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--p-green, #2A5934);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pawely-features__feature-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pawely-features__feature-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--p-dark, #16281E);
    margin: 0;
  }

  .pawely-features__feature-desc {
    font-size: 0.875rem;
    color: var(--p-stone-500, #78716C);
    line-height: 1.55;
    margin: 0;
  }

  @media screen and (min-width: 640px) {
    .pawely-features {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }

    .pawely-features__inner {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .pawely-features__feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .pawely-features__inner {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .pawely-features__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 4rem;
    }

    .pawely-features__image-col {
      grid-column: span 4;
    }

    .pawely-features__content-col {
      grid-column: span 8;
    }

    .pawely-features__product-image {
      width: 20rem;
      height: 20rem;
    }

    .pawely-features__heading {
      font-size: 2.5rem;
    }
  }
{% endstylesheet %}

{%- liquid
  assign sun_icon = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>'
  assign bubbles_icon = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="14" r="4"/><circle cx="16" cy="10" r="4"/><circle cx="12" cy="19" r="2"/></svg>'
  assign cube_icon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>'
  assign cog_icon = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 0 0 4.93 19.07M19.07 4.93l-1.41 1.41M4.93 19.07l1.41-1.41M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M18.36 18.36l1.41 1.41M4.93 19.07l1.41-1.41M18.36 5.64l1.41-1.41"/></svg>'
-%}

<section class="pawely-features" id="pawely-features-{{ section.id }}">
  <div class="pawely-features__inner">
    <div class="pawely-features__grid">

      <!-- Left: Product Image -->
      <div class="pawely-features__image-col">
        {% if section.settings.product_image != blank %}
          {{ section.settings.product_image | image_url: width: 640 | image_tag:
            class: 'pawely-features__product-image',
            alt: section.settings.product_image.alt,
            loading: 'lazy',
            width: section.settings.product_image.width,
            height: section.settings.product_image.height
          }}
        {% else %}
          <img
            class="pawely-features__product-image"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkNcWn-LHezFJQQQnPqc-Mnujf3lrhuYULLvEFnCrxTsuz3_-Oln5pPjkNZRHDqE2DlDB9HdqztBtf_EIofkQA_pR5ivADuz0cyA_Kc6VQVTRJv8kSQI520QtQWggjMsnqbjaHZy1TIEIf6UCAWfG9Ulam8JR604N7A57r3TuEIfkagTO7vKnh6Rfa5gXOKsJCd6AXKEHSfHS1qNVvktnLdmbiXm9STiBciM3UUos_tHxlpheNYxkkFw"
            alt="Pawely Dog Shower Sprayer"
            loading="lazy"
            width="640"
            height="640"
          >
        {% endif %}
      </div>

      <!-- Right: Content + Features -->
      <div class="pawely-features__content-col">
        {% if section.settings.eyebrow != blank %}
          <span class="pawely-features__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        <h2 class="pawely-features__heading">{{ section.settings.heading }}</h2>

        {% if section.settings.description != blank %}
          <p class="pawely-features__description">{{ section.settings.description }}</p>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link }}" class="pawely-features__cta">
            {{ section.settings.cta_label }}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="pawely-features__feature-grid">
            {% for block in section.blocks %}
              {%- liquid
                case block.settings.icon
                  when 'sun'
                    assign icon_svg = sun_icon
                  when 'bubbles'
                    assign icon_svg = bubbles_icon
                  when 'cube'
                    assign icon_svg = cube_icon
                  when 'cog'
                    assign icon_svg = cog_icon
                  else
                    assign icon_svg = sun_icon
                endcase
              -%}
              <div class="pawely-features__feature-item" {{ block.shopify_attributes }}>
                <div class="pawely-features__feature-icon-wrap">
                  {{ icon_svg }}
                </div>
                <div class="pawely-features__feature-body">
                  <p class="pawely-features__feature-title">{{ block.settings.title }}</p>
                  {% if block.settings.description != blank %}
                    <p class="pawely-features__feature-desc">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pawely Features",
  "tag": "div",
  "class": "pawely-features-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "All-in-One Design"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spray. Scrub. Clean."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The Pawely dog shower sprayer combines water pressure with a built-in soap dispenser and gentle silicone scrubber—everything you need in one easy tool."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Get Yours Today"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Sun / Power" },
            { "value": "bubbles", "label": "Bubbles / Soap" },
            { "value": "cube", "label": "Cube / Scrubber" },
            { "value": "cog", "label": "Cog / Fits Any Hose" }
          ],
          "default": "sun"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Short description of this feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pawely Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "sun",
            "title": "Powerful Rinse",
            "description": "High-pressure water jets cut through dirt and debris, rinsing your dog thoroughly in seconds."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "bubbles",
            "title": "Built-in Soap Dispenser",
            "description": "Fill the reservoir with your favourite shampoo and dispense with a single click—no bottles needed."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "cube",
            "title": "Gentle Scrubber",
            "description": "Soft silicone bristles massage your dog while scrubbing away grime for a thorough, soothing clean."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "cog",
            "title": "Fits Any Hose",
            "description": "Universal connector works with any standard garden hose—just attach and start washing."
          }
        }
      ]
    }
  ]
}
{% endschema %}
