{% comment %}
  Customer Reviews / Social Proof Section
  Renders a responsive row of 3 testimonial cards or supports dynamic Shopify review app blocks (@app).
{% endcomment %}

<div
  class="customer-reviews color-{{ section.settings.color_scheme }}"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    
    {% comment %} Section Header {% endcomment %}
    <div class="customer-reviews__header">
      {% if section.settings.eyebrow != blank %}
        <span class="hero-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="customer-reviews__heading h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="customer-reviews__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    {% comment %} Review App Integration Hook (@app blocks) {% endcomment %}
    {% capture app_blocks %}
      {% content_for 'blocks' %}
    {% endcapture %}

    {% if app_blocks != blank %}
      <div class="customer-reviews__app-wrapper">
        {{ app_blocks }}
      </div>
    {% endif %}

    {% comment %} Testimonial Cards Row {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="customer-reviews__grid">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <blockquote class="customer-reviews__card" {{ block.shopify_attributes }}>
              
              {% comment %} Star Rating Display {% endcomment %}
              <div class="customer-reviews__stars" aria-label="{{ block.settings.rating | default: 5 }} out of 5 stars">
                {% assign star_rating = block.settings.rating | default: 5 %}
                {% for i in (1..5) %}
                  <svg class="customer-reviews__star-icon {% if i <= star_rating %}filled{% endif %}" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                {% endfor %}
              </div>

              {% comment %} Quote Content {% endcomment %}
              {% if block.settings.quote != blank %}
                <p class="customer-reviews__quote">“{{ block.settings.quote | escape }}”</p>
              {% endif %}

              {% comment %} Customer Details & Avatar Footer {% endcomment %}
              <footer class="customer-reviews__footer">
                {% if block.settings.avatar != blank %}
                  {{
                    block.settings.avatar
                    | image_url: width: 120
                    | image_tag:
                      loading: 'lazy',
                      class: 'customer-reviews__avatar',
                      alt: block.settings.author | default: 'Customer' | escape
                  }}
                {% else %}
                  <div class="customer-reviews__avatar-placeholder">
                    {{ block.settings.author | slice: 0 | default: 'C' | upcase }}
                  </div>
                {% endif %}

                <div class="customer-reviews__author-info">
                  {% if block.settings.author != blank %}
                    <cite class="customer-reviews__author-name">{{ block.settings.author | escape }}</cite>
                  {% endif %}
                  
                  {% if block.settings.verified %}
                    <span class="customer-reviews__verified-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      Verified Buyer
                    </span>
                  {% endif %}
                </div>
              </footer>

            </blockquote>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .customer-reviews {
    padding-top: var(--padding-top, 48px);
    padding-bottom: var(--padding-bottom, 48px);
  }

  .customer-reviews__header {
    max-width: 640px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .customer-reviews__heading {
    margin-block-start: 0.5rem;
    margin-block-end: 0.75rem;
    color: var(--color-charcoal-heading, #161C16);
    line-height: 1.2;
  }

  .customer-reviews__description {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-charcoal-text, #2B302B);
    opacity: 0.9;
  }

  .customer-reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .customer-reviews__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;
    padding: 1.75rem;
    background-color: var(--color-warm-base, #FAF8F5);
    border-radius: var(--radius-editorial-card, 20px);
    border: 1px solid var(--color-soft-border-neutral, #E2DFD7);
    box-shadow: var(--shadow-restrained-card, 0 4px 20px -2px rgba(24, 38, 28, 0.05));
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .customer-reviews__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px -4px rgba(24, 38, 28, 0.09);
  }

  .customer-reviews__stars {
    display: flex;
    gap: 0.25rem;
    margin-block-end: 1rem;
    color: #E2B258;
  }

  .customer-reviews__star-icon.filled {
    fill: #E2B258;
    stroke: #E2B258;
  }

  .customer-reviews__quote {
    margin: 0 0 1.5rem 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-charcoal-text, #2B302B);
    font-style: italic;
    opacity: 0.95;
    flex-grow: 1;
  }

  .customer-reviews__footer {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-style: normal;
  }

  .customer-reviews__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-soft-border-neutral, #E2DFD7);
  }

  .customer-reviews__avatar-placeholder {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-pale-green-accent, #E8EFE9);
    color: var(--color-deep-green-action, #1E3A2B);
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .customer-reviews__author-info {
    display: flex;
    flex-direction: column;
  }

  .customer-reviews__author-name {
    font-size: 0.925rem;
    font-weight: 600;
    font-style: normal;
    color: var(--color-charcoal-heading, #161C16);
  }

  .customer-reviews__verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-deep-green-action, #1E3A2B);
    font-weight: 500;
    margin-block-start: 0.15rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer Reviews",
  "class": "customer-reviews-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "COMMUNITY REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Pets & Their Humans"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Supporting Description",
      "default": "Read real experiences from our community of pet parents enjoying effortless, calm bath times."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonial Quote",
          "default": "Bath time used to be a ordeal, but this gentle spray nozzle made it so peaceful. My golden retriever actually enjoys it now!"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Customer Avatar / Photo"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Sarah M."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Buyer Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Bath time used to be a stressful ordeal, but this gentle 3-mode sprayer made it so peaceful. My dog actually stands still and enjoys the massage!",
            "author": "Elena R.",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "The built-in soap reservoir is a game changer. I get rich lather in seconds without juggling shampoo bottles. Highly recommended!",
            "author": "Marcus T.",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Super high quality nozzle with soft rubber pins. It rinsed out my doodle's thick double coat in half the usual time.",
            "author": "Chloe W.",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
