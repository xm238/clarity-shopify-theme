<style>
  .pawely-product {
    padding: 4rem 0;
    background-color: #fff;
    border-bottom: 1px solid #E7E5E4;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .pawely-product__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .pawely-product__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* ---- Gallery ---- */
  .pawely-product__gallery {
    display: flex;
    gap: 0.75rem;
  }

  .pawely-product__thumbs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .pawely-product__thumb {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.625rem;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.15s ease;
  }

  .pawely-product__thumb.is-active,
  .pawely-product__thumb:hover {
    border-color: #2A5934;
  }

  .pawely-product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pawely-product__main-image-wrap {
    flex: 1;
    border-radius: 1rem;
    overflow: hidden;
    background-color: #F5F5F4;
    aspect-ratio: 1 / 1;
  }

  .pawely-product__main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  /* ---- Details ---- */
  .pawely-product__details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pawely-product__bestseller-badge {
    display: inline-block;
    background-color: #DCFCE7;
    color: #15803D;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .pawely-product__title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #16281E;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .pawely-product__rating {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .pawely-product__stars {
    display: flex;
    gap: 0.125rem;
  }

  .pawely-product__stars svg {
    width: 1rem;
    height: 1rem;
    color: #F59E0B;
  }

  .pawely-product__rating-text {
    font-size: 0.8125rem;
    color: #78716C;
  }

  .pawely-product__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pawely-product__price {
    font-size: 1.875rem;
    font-weight: 800;
    color: #16281E;
    line-height: 1;
  }

  .pawely-product__compare-price {
    font-size: 1rem;
    color: #A8A29E;
    text-decoration: line-through;
  }

  .pawely-product__save-badge {
    background-color: #FEE2E2;
    color: #DC2626;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .pawely-product__short-desc {
    font-size: 0.9375rem;
    color: #57534E;
    line-height: 1.65;
    margin: 0;
  }

  .pawely-product__qty-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pawely-product__qty-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #292524;
  }

  .pawely-product__qty-control {
    display: inline-flex;
    align-items: center;
    border: 1px solid #D6D3D1;
    border-radius: 0.625rem;
    overflow: hidden;
    width: max-content;
  }

  .pawely-product__qty-btn {
    background: none;
    border: none;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.125rem;
    font-weight: 400;
    color: #44403C;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .pawely-product__qty-btn:hover {
    background-color: #F5F5F4;
    color: #2A5934;
  }

  .pawely-product__qty-input {
    width: 3rem;
    text-align: center;
    border: none;
    border-left: 1px solid #D6D3D1;
    border-right: 1px solid #D6D3D1;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #16281E;
    font-family: 'Inter', system-ui, sans-serif;
    padding: 0;
    height: 2.5rem;
    -moz-appearance: textfield;
    background: transparent;
    outline: none;
  }

  .pawely-product__qty-input::-webkit-inner-spin-button,
  .pawely-product__qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pawely-product__cta-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .pawely-product__add-to-cart {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.875rem 1.5rem;
    background-color: #16281E;
    color: #FBF9F5;
    border: none;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    font-family: 'Inter', system-ui, sans-serif;
    cursor: pointer;
    transition: background-color 0.2s ease;
    letter-spacing: 0.01em;
  }

  .pawely-product__add-to-cart:hover {
    background-color: #2A5934;
  }

  .pawely-product__shopify-pay-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 100%;
    padding: 0.875rem 1.5rem;
    background-color: #5A31F4;
    color: #fff;
    border: none;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    font-family: 'Inter', system-ui, sans-serif;
    cursor: pointer;
    transition: background-color 0.2s ease;
    letter-spacing: 0.01em;
  }

  .pawely-product__shopify-pay-btn:hover {
    background-color: #4c28d1;
  }

  .shopify-pay-badge {
    font-style: normal;
  }

  .pawely-product__guarantees {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    background-color: #F5F5F4;
    border-radius: 0.75rem;
  }

  .pawely-product__guarantee-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
    flex: 1;
  }

  .pawely-product__guarantee-item svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #2A5934;
  }

  .pawely-product__guarantee-text {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #44403C;
    line-height: 1.3;
  }

  /* ---- Video card ---- */
  .pawely-product__video-card {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    background-color: #1C1917;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }

  .pawely-product__video-thumb {
    width: 100%;
    display: block;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    opacity: 0.85;
  }

  .pawely-product__video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(to top, rgba(28,25,23,0.7) 0%, transparent 60%);
  }

  .pawely-product__video-play {
    width: 3.5rem;
    height: 3.5rem;
    background-color: rgba(255,255,255,0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    text-decoration: none;
    flex-shrink: 0;
  }

  .pawely-product__video-play:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 28px rgba(0,0,0,0.35);
  }

  .pawely-product__video-play svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #16281E;
    margin-left: 0.125rem;
  }

  .pawely-product__video-badge {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    background-color: rgba(251,249,245,0.95);
    color: #16281E;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }

  .pawely-product__video-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem;
    color: #fff;
    text-align: center;
  }

  .pawely-product__video-caption strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .pawely-product__video-caption span {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  @media (min-width: 640px) {
    .pawely-product {
      padding: 6rem 0;
    }
  }

  @media (min-width: 1024px) {
    .pawely-product__grid {
      grid-template-columns: 5fr 4fr 3fr;
    }
  }
</style>

