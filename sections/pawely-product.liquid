<script>
  document.querySelectorAll('.pawely-thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src');
      const mainImg = document.getElementById('pawely-main-img');
      if (mainImg && src) {
        mainImg.src = src;
      }
      document.querySelectorAll('.pawely-thumb').forEach(b => {
        b.classList.remove('border-brand-green');
        b.classList.add('border-stone-200');
      });
      btn.classList.remove('border-stone-200');
      btn.classList.add('border-brand-green');
    });
  });
</script>

{% schema %}
{
  "name": "Pawely Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short Description",
      "default": "Turn any hose into a professional pet shower. Rinse, scrub, and clean your dog in minutes — at home, anytime."
    }
  ],
  "presets": [
    {
      "name": "Pawely Product"
    }
  ]
}
{% endschema %}
