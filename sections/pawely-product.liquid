{% if featured_product != blank %}
<script>
  // Variant image data from Shopify
  var pawelyVariantImages = {
    {% for variant in featured_product.variants %}
      "{{ variant.id }}": {% if variant.featured_image %}"{{ variant.featured_image | image_url: width: 800 }}"{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  // Variant select → swap main image
  var variantSelect = document.getElementById('pawely-variant-select');
  if (variantSelect) {
    variantSelect.addEventListener('change', function() {
      var imgSrc = pawelyVariantImages[this.value];
      if (imgSrc) {
        var mainImg = document.getElementById('pawely-main-img');
        if (mainImg) mainImg.src = imgSrc;
      }
    });
  }

  // Thumbnail click → swap main image
  document.querySelectorAll('.pawely-thumb').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var src = btn.getAttribute('data-src');
      var mainImg = document.getElementById('pawely-main-img');
      if (mainImg && src) mainImg.src = src;
      document.querySelectorAll('.pawely-thumb').forEach(function(b) {
        b.classList.remove('border-brand-green');
        b.classList.add('border-stone-200');
      });
      btn.classList.remove('border-stone-200');
      btn.classList.add('border-brand-green');
    });
  });
</script>
{% endif %}

{% schema %}
{
  "name": "PawJet™ Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short Description",
      "default": "Turn any hose into a professional pet shower. Rinse, scrub, and clean your dog in minutes — at home, anytime."
    }
  ],
  "presets": [
    {
      "name": "PawJet™ Product"
    }
  ]
}
{% endschema %}
