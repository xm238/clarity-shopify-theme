{% if featured_product != blank %}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <product-form class="block w-full">
    {% form 'product', featured_product, id: 'pawely-product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
      {% unless featured_product.has_only_default_variant %}
        <div class="mb-4">
          <label class="block text-xs font-bold text-stone-700 mb-1">Select Option</label>
          <select id="pawely-variant-select" name="id" class="w-full text-sm rounded-lg p-2.5 outline-none" style="border: 1px solid #d6d3d1 !important; background-color: #fafaf9 !important;">
            {% for variant in featured_product.variants %}
              <option value="{{ variant.id }}" {% if variant == featured_product.selected_or_first_available_variant %}selected{% endif %}>
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% else %}
        <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">
      {% endunless %}
      
      <!-- Quantity Selector -->
      <div class="flex items-center gap-3 mb-5">
        <div class="flex items-center border border-stone-300 rounded-lg overflow-hidden bg-stone-50" style="border: 1px solid #d6d3d1 !important; background-color: #fafaf9 !important; border-radius: 0.5rem !important;">
          <button class="w-8 h-8 flex items-center justify-center text-stone-600 hover:bg-stone-200 text-sm font-bold" type="button" onclick="const i=document.getElementById('pawely-qty-val'); i.value=Math.max(1, parseInt(i.value)-1);" style="border: none !important; background: transparent !important; min-width: 2rem !important; height: 2rem !important; padding: 0 !important; margin: 0 !important; box-shadow: none !important; min-height: 0 !important; color: #57534e !important; border-radius: 0 !important;">-</button>
          <input id="pawely-qty-val" type="number" name="quantity" value="1" min="1" class="w-8 text-center text-xs font-bold text-stone-800" style="border: none !important; background: transparent !important; min-width: 2rem !important; height: 2rem !important; padding: 0 !important; margin: 0 !important; box-shadow: none !important; min-height: 0 !important; border-radius: 0 !important; appearance: none !important;">
          <button class="w-8 h-8 flex items-center justify-center text-stone-600 hover:bg-stone-200 text-sm font-bold" type="button" onclick="const i=document.getElementById('pawely-qty-val'); i.value=parseInt(i.value)+1;" style="border: none !important; background: transparent !important; min-width: 2rem !important; height: 2rem !important; padding: 0 !important; margin: 0 !important; box-shadow: none !important; min-height: 0 !important; color: #57534e !important; border-radius: 0 !important;">+</button>
        </div>
        <span class="text-xs text-stone-500 font-medium">Quantity</span>
      </div>
      
      <!-- Action Buttons -->
      <div class="flex items-center gap-2 mb-6 pawely-actions">
        <style>
          .pawely-actions .shopify-payment-button__button {
            border-radius: 0.75rem !important;
            min-height: 48px !important;
            font-weight: 700 !important;
            font-size: 0.875rem !important;
            box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1) !important;
            background-color: #5A31F4 !important; /* Purple */
            color: white !important;
            width: 100% !important;
          }
          .pawely-actions .shopify-payment-button__button:hover {
            opacity: 0.95 !important;
            background-color: #5A31F4 !important;
          }
        </style>
        <button name="add" class="flex-1 font-bold text-sm py-3.5 rounded-xl transition shadow flex items-center justify-center hover:opacity-90" type="submit" style="background-color: #2A5934 !important; color: white !important;" {% if featured_product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
          {% if featured_product.selected_or_first_available_variant.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </button>
        <div class="flex-1">
          {{ form | payment_button }}
        </div>
      </div>
    {% endform %}
  </product-form>
{% else %}
