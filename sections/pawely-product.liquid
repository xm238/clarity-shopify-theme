{%- assign placeholder_thumb1 = 'https://lh3.googleusercontent.com/aida-public/AB6AXuB0c58EDHRogjBBa-iWGdNFScIn4qh7Z01z6Xpl6-v3t8C3Chp8-zecWWLCLUB9buojwethqJoHi4xhSmEek6P5VFNGecPItoblrX_rcWMipLjs94kMtanO-iY-FvxtadHkLAVf7Anga4qpnt1Mq7ntLoBOtQtC57YFsw5cXsDoJy4Xw4m4CsCtt9__wl2cWuW2M7T-4GCdkeMMGdT2fUcotf5Fwv3csTthoAwNba6OQ0LHezSyWd0L7A' -%}
{%- assign placeholder_thumb2 = 'https://lh3.googleusercontent.com/aida-public/AB6AXuAdX9qxzgX8vPY9bKwxpASWQOXn5jPDlS8NgWX-m1vrOl2DrCpDq95P8XcUM0YN2s3h2KUiYLMsMZr2M3o3CcxFf3R484kRpgaDfotyvoskKrCZaYWHI8RxIe3mI479TecsBI1F_Mj4vmGyynwpvnhM92bFVHh82m1kfNrlgZs0ejB1XzDW2isVzczwcAyhWBi6Pie3eKvls6XFcgh1RGS3QWh68zKk8Xy2Cr-wcY4I8xjJFb7OTAlQjw' -%}
