<section id="product-purchase" class="pawely-product">
  <div class="pawely-product__inner">
    <div class="pawely-product__grid">

      <!-- ======= Image Gallery ======= -->
      <div class="pawely-product__gallery">
        <div class="pawely-product__thumbs" role="list" aria-label="Product thumbnails">
          {%- if featured_product != blank and featured_product.images.size > 0 -%}
            {%- assign thumb_count = 0 -%}
            {%- for image in featured_product.images limit: 4 -%}
              {%- assign thumb_count = thumb_count | plus: 1 -%}
              <button
                class="pawely-product__thumb{% if forloop.first %} is-active{% endif %}"
                type="button"
                onclick="pawely_setMainImage(this, '{{ image | image_url: width: 900 }}')"
                aria-label="{{ image.alt | default: featured_product.title }} image {{ forloop.index }}"
                role="listitem"
              >
                <img
                  src="{{ image | image_url: width: 120 }}"
                  alt="{{ image.alt | default: featured_product.title }}"
                  loading="lazy"
                  width="120"
                  height="120"
                >
              </button>
            {%- endfor -%}
          {%- else -%}
            <button class="pawely-product__thumb is-active" type="button" onclick="pawely_setMainImage(this, '{{ placeholder_main }}')" aria-label="Product image 1" role="listitem">
              <img src="{{ placeholder_thumb1 }}" alt="Product preview 1" loading="lazy" width="120" height="120">
            </button>
            <button class="pawely-product__thumb" type="button" onclick="pawely_setMainImage(this, '{{ placeholder_thumb2 }}')" aria-label="Product image 2" role="listitem">
              <img src="{{ placeholder_thumb2 }}" alt="Product preview 2" loading="lazy" width="120" height="120">
            </button>
            <button class="pawely-product__thumb" type="button" onclick="pawely_setMainImage(this, '{{ placeholder_thumb3 }}')" aria-label="Product image 3" role="listitem">
              <img src="{{ placeholder_thumb3 }}" alt="Product preview 3" loading="lazy" width="120" height="120">
            </button>
          {%- endif -%}
        </div>

        <div class="pawely-product__main-image-wrap">
          {%- if featured_product != blank and featured_product.featured_image != blank -%}
            <img
              id="pawely-main-image"
              class="pawely-product__main-image"
              src="{{ featured_product.featured_image | image_url: width: 900 }}"
              alt="{{ featured_product.featured_image.alt | default: featured_product.title }}"
              loading="eager"
              width="900"
              height="900"
            >
          {%- else -%}
            <img
              id="pawely-main-image"
              class="pawely-product__main-image"
              src="{{ placeholder_main }}"
              alt="Product preview"
              loading="eager"
              width="900"
              height="900"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- ======= Product Details ======= -->
      <div class="pawely-product__details">

        <div>
          <span class="pawely-product__bestseller-badge">#1 Bestseller</span>
        </div>

        {%- if featured_product != blank -%}
          <h2 class="pawely-product__title">{{ featured_product.title }}</h2>
        {%- else -%}
          <h2 class="pawely-product__title">Pawely Pet Shower Head</h2>
        {%- endif -%}

        <div class="pawely-product__rating" aria-label="4.8 out of 5 stars, 1200 reviews">
          <div class="pawely-product__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {%- endfor -%}
          </div>
          <span class="pawely-product__rating-text">4.8 (1,200+ reviews)</span>
        </div>

        {%- if featured_product != blank -%}
          <div class="pawely-product__price-row">
            <span class="pawely-product__price">{{ featured_product.price | money }}</span>
            {%- if featured_product.compare_at_price > featured_product.price -%}
              <span class="pawely-product__compare-price">{{ featured_product.compare_at_price | money }}</span>
              {%- assign savings = featured_product.compare_at_price | minus: featured_product.price -%}
              {%- assign savings_pct = savings | times: 100 | divided_by: featured_product.compare_at_price -%}
              <span class="pawely-product__save-badge">Save {{ savings_pct }}%</span>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="pawely-product__price-row">
            <span class="pawely-product__price">$39.99</span>
            <span class="pawely-product__compare-price">$59.99</span>
            <span class="pawely-product__save-badge">Save 33%</span>
          </div>
        {%- endif -%}

        {%- if section.settings.short_description != blank -%}
          <p class="pawely-product__short-desc">{{ section.settings.short_description }}</p>
        {%- endif -%}

        {%- if featured_product != blank -%}
          {%- form 'product', featured_product, id: 'pawely-product-form' -%}
            <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">

            <div class="pawely-product__qty-row">
              <label class="pawely-product__qty-label" for="pawely-qty">Quantity</label>
              <div class="pawely-product__qty-control">
                <button type="button" class="pawely-product__qty-btn" id="pawely-qty-minus" aria-label="Decrease quantity">&#8722;</button>
                <input
                  class="pawely-product__qty-input"
                  type="number"
                  id="pawely-qty"
                  name="quantity"
                  value="1"
                  min="1"
                  aria-label="Quantity"
                >
                <button type="button" class="pawely-product__qty-btn" id="pawely-qty-plus" aria-label="Increase quantity">&#43;</button>
              </div>
            </div>

            <div class="pawely-product__cta-wrap">
              <button type="submit" name="add" class="pawely-product__add-to-cart">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <path d="M16 10a4 4 0 01-8 0"/>
                </svg>
                Add to Cart
              </button>

              <shopify-accelerated-checkout
                product-id="{{ featured_product.id }}"
                variant-id="{{ featured_product.selected_or_first_available_variant.id }}"
              >
                <button type="button" class="pawely-product__shopify-pay-btn">
                  Buy with <span>shop</span><span class="shopify-pay-badge">Pay</span>
                </button>
              </shopify-accelerated-checkout>
            </div>
          {%- endform -%}
        {%- else -%}
          <div class="pawely-product__qty-row">
            <span class="pawely-product__qty-label">Quantity</span>
            <div class="pawely-product__qty-control">
              <button type="button" class="pawely-product__qty-btn" aria-label="Decrease quantity">&#8722;</button>
              <input class="pawely-product__qty-input" type="number" value="1" min="1" aria-label="Quantity" readonly>
              <button type="button" class="pawely-product__qty-btn" aria-label="Increase quantity">&#43;</button>
            </div>
          </div>
          <div class="pawely-product__cta-wrap">
            <button type="button" class="pawely-product__add-to-cart">Add to Cart</button>
            <button type="button" class="pawely-product__shopify-pay-btn">Buy with <span>shop</span><span class="shopify-pay-badge">Pay</span></button>
          </div>
        {%- endif -%}

        <div class="pawely-product__guarantees" role="list" aria-label="Guarantees">
          <div class="pawely-product__guarantee-item" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
            <span class="pawely-product__guarantee-text">Free Shipping Worldwide</span>
          </div>
          <div class="pawely-product__guarantee-item" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="pawely-product__guarantee-text">30-Day Returns</span>
          </div>
          <div class="pawely-product__guarantee-item" role="listitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
            <span class="pawely-product__guarantee-text">Secure Payment</span>
          </div>
        </div>

      </div>

      <!-- ======= Video Card ======= -->
      <div class="pawely-product__video-card">
        <img
          class="pawely-product__video-thumb"
          src="{{ section.settings.video_thumbnail_url }}"
          alt="Product video preview"
          loading="lazy"
        >
        <span class="pawely-product__video-badge">Soap On</span>
        <div class="pawely-product__video-overlay">
          {%- if section.settings.video_url != blank -%}
            <a
              href="{{ section.settings.video_url }}"
              class="pawely-product__video-play"
              aria-label="Watch how it works"
              target="_blank"
              rel="noopener noreferrer"
            >
          {%- else -%}
            <span class="pawely-product__video-play" aria-label="Watch how it works">
          {%- endif -%}
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <polygon points="5 3 19 12 5 21 5 3"/>
              </svg>
          {%- if section.settings.video_url != blank -%}
            </a>
          {%- else -%}
            </span>
          {%- endif -%}
        </div>
        <div class="pawely-product__video-caption">
          <strong>Watch how it works</strong>
          <span>See it in action in 30 seconds.</span>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    function pawely_setMainImage(thumbBtn, src) {
      var img = document.getElementById('pawely-main-image');
      if (img) {
        img.style.opacity = '0';
        setTimeout(function () {
          img.src = src;
          img.style.opacity = '1';
        }, 150);
      }
      var thumbs = thumbBtn.closest('.pawely-product__thumbs');
      if (thumbs) {
        thumbs.querySelectorAll('.pawely-product__thumb').forEach(function (t) {
          t.classList.remove('is-active');
        });
      }
      thumbBtn.classList.add('is-active');
    }

    window.pawely_setMainImage = pawely_setMainImage;

    document.addEventListener('DOMContentLoaded', function () {
      var minusBtn = document.getElementById('pawely-qty-minus');
      var plusBtn = document.getElementById('pawely-qty-plus');
      var qtyInput = document.getElementById('pawely-qty');

      if (minusBtn && plusBtn && qtyInput) {
        minusBtn.addEventListener('click', function () {
          var current = parseInt(qtyInput.value, 10) || 1;
          if (current > 1) {
            qtyInput.value = current - 1;
          }
        });

        plusBtn.addEventListener('click', function () {
          var current = parseInt(qtyInput.value, 10) || 1;
          qtyInput.value = current + 1;
        });
      }
    });
  })();
</script>

