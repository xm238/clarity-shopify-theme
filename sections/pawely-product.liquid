    <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">
    <!-- Quantity Selector -->
    <div class="flex items-center gap-3 mb-5">
      <div class="flex items-center border border-stone-300 rounded-lg overflow-hidden bg-stone-50">
        <button class="w-8 h-8 flex items-center justify-center text-stone-600 hover:bg-stone-200 text-sm font-bold" type="button" onclick="const i=document.getElementById('pawely-qty-val'); i.value=Math.max(1, parseInt(i.value)-1);">-</button>
        <input id="pawely-qty-val" type="number" name="quantity" value="1" min="1" class="w-8 text-center text-xs font-bold text-stone-800 border-0 bg-transparent p-0 focus:ring-0">
        <button class="w-8 h-8 flex items-center justify-center text-stone-600 hover:bg-stone-200 text-sm font-bold" type="button" onclick="const i=document.getElementById('pawely-qty-val'); i.value=parseInt(i.value)+1;">+</button>
      </div>
      <span class="text-xs text-stone-500 font-medium">Quantity</span>
    </div>
    <!-- Action Buttons -->
    <div class="space-y-2.5 mb-6">
      <button class="w-full bg-brand-dark hover:bg-brand-green text-white font-bold text-sm py-3.5 rounded-xl transition shadow" type="submit">
        Add to Cart
      </button>
      <shopify-accelerated-checkout product-id="{{ featured_product.id }}" variant-id="{{ featured_product.selected_or_first_available_variant.id }}">
        <button class="w-full bg-brand-shoppay hover:opacity-95 text-white font-bold text-sm py-3.5 rounded-xl transition flex items-center justify-center gap-1.5 shadow" type="button">
          <span class="">Buy with</span>
          <span class="font-black tracking-tight text-white italic">shop <span class="bg-white text-brand-shoppay px-1 rounded not-italic font-bold text-xs">Pay</span></span>
        </button>
      </shopify-accelerated-checkout>
    </div>
  {% endform %}
{% else %}
  <div class="flex items-center gap-3 mb-5">
    <div class="flex items-center border border-stone-300 rounded-lg overflow-hidden bg-stone-50">
      <button class="w-8 h-8 flex items-center justify-center text-stone-600 hover:bg-stone-200 text-sm font-bold" type="button">-</button>
