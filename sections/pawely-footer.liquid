<footer class="bg-brand-cream text-stone-600 pt-10 sm:pt-16 pb-6 sm:pb-12 text-xs">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="!grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 pb-8 sm:pb-12 border-b border-stone-200">
<!-- Left: Brand Info -->
<div class="md:col-span-4">
<a class="flex items-center gap-2 text-lg font-black text-brand-dark mb-2" href="{{ routes.root_url }}">
<svg class="w-5 h-5 fill-brand-dark" viewBox="0 0 24 24">
<circle cx="7" cy="8.5" r="2"></circle>
<circle cx="17" cy="8.5" r="2"></circle>
<circle cx="10.5" cy="5" r="2"></circle>
<circle cx="13.5" cy="5" r="2"></circle>
<path d="M12 11.5c-3.2 0-5.8 2.2-5.8 5 0 2.2 1.8 3.5 3.5 3.5 1.2 0 1.9-.6 2.3-.6.4 0 1.1.6 2.3.6 1.7 0 3.5-1.3 3.5-3.5 0-2.8-2.6-5-5.8-5z"></path>
</svg>
<span class="">{{ section.settings.brand_name }}</span>
</a>
<p class="text-stone-500 max-w-xs leading-relaxed text-xs">
            {{ section.settings.tagline }}
          </p>
</div>
<!-- Center: Links & Socials -->
<div class="md:col-span-4 flex flex-col justify-between">
<div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-medium text-stone-700 mb-4 sm:mb-6">
<!-- Nav Links Removed -->
</div>
<!-- Social Icons -->
<div class="flex items-center space-x-4 text-stone-700">
<!-- Instagram -->
<a aria-label="Instagram" class="hover:text-brand-green transition" href="#">
<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
</a>
<!-- TikTok -->
<a aria-label="TikTok" class="hover:text-brand-green transition" href="#">
<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1.01-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
</a>
</div>
</div>
<!-- Right: Email Newsletter -->
<div class="md:col-span-4">
<p class="font-bold text-stone-900 mb-2 text-xs">Join our pack for special offers.</p>
{% form 'customer', class: 'flex items-center' %}
  <input type="hidden" name="contact[tags]" value="newsletter">
  <input class="w-full bg-white border border-stone-300 rounded-l-lg px-3 py-2 text-xs focus:ring-1 focus:ring-brand-green focus:border-brand-green text-stone-800 placeholder-stone-400" placeholder="Your email" required type="email" name="contact[email]">
  <button class="px-3.5 py-2 rounded-r-lg text-xs font-bold transition flex items-center justify-center hover:opacity-90" type="submit" style="background-color: #16281E !important; color: white !important;">
    →
  </button>
{% endform %}
</div>
</div>
<!-- Legal Bottom Subfooter -->
<div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-stone-500 gap-4 text-[11px]">
<span class="text-center sm:text-left">{{ section.settings.copyright_text }}</span>
<div class="flex flex-wrap justify-center sm:justify-end items-center gap-3 sm:gap-5">
<a class="hover:underline cursor-pointer" onclick="openPaWashPolicy(event, 'privacy', 'Privacy Policy')">Privacy Policy</a>
<a class="hover:underline cursor-pointer" onclick="openPaWashPolicy(event, 'tos', 'Terms of Service')">Terms of Service</a>
<a class="hover:underline cursor-pointer" onclick="openPaWashPolicy(event, 'shipping', 'Shipping Policy')">Shipping Policy</a>
<a class="hover:underline cursor-pointer" onclick="openPaWashPolicy(event, 'refund', 'Return Policy')">Return Policy</a>
</div>
</div>
</div>
</footer>

{% schema %}
{
  "name": "PaWash Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "PaWash™"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Small moments. A cleaner, happier tomorrow."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2024 PaWash™. All rights reserved."
    }
  ]
}
{% endschema %}
