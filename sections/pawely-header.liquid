<style>
  .pawely-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #FBF9F5;
    border-bottom: 1px solid rgba(231, 229, 228, 0.6);
  }

  .pawely-header__inner {
    max-width: 80rem;
    margin: 0 auto;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
  }

  .pawely-header__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #16281E;
    font-size: 1.25rem;
    font-weight: 800;
    font-family: 'Inter', system-ui, sans-serif;
    letter-spacing: -0.02em;
  }

  .pawely-header__logo:hover {
    color: #2A5934;
  }

  .pawely-header__logo svg {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    color: #2A5934;
  }

  .pawely-header__nav {
    display: none;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pawely-header__nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: #44403C;
    text-decoration: none;
    font-family: 'Inter', system-ui, sans-serif;
    transition: color 0.15s ease;
  }

  .pawely-header__nav a:hover {
    color: #2A5934;
  }

  .pawely-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pawely-header__action-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #44403C;
    text-decoration: none;
    padding: 0.375rem;
    border-radius: 0.5rem;
    transition: color 0.15s ease, background-color 0.15s ease;
    position: relative;
  }

  .pawely-header__action-link:hover {
    color: #2A5934;
    background-color: rgba(42, 89, 52, 0.06);
  }

  .pawely-header__action-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .pawely-header__cart-badge {
    position: absolute;
    top: -0.125rem;
    right: -0.125rem;
    background-color: #2A5934;
    color: #FBF9F5;
    font-size: 0.625rem;
    font-weight: 700;
    font-family: 'Inter', system-ui, sans-serif;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .pawely-header__nav {
      display: flex;
    }
  }
</style>

<header class="pawely-header" role="banner">
  <div class="pawely-header__inner">

    <a href="{{ routes.root_url }}" class="pawely-header__logo" aria-label="{{ section.settings.brand_name }} - Home">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <circle cx="7" cy="8.5" r="2"/>
        <circle cx="17" cy="8.5" r="2"/>
        <circle cx="10.5" cy="5" r="2"/>
        <circle cx="13.5" cy="5" r="2"/>
        <path d="M12 11.5c-3.2 0-5.8 2.2-5.8 5 0 2.2 1.8 3.5 3.5 3.5 1.2 0 1.9-.6 2.3-.6.4 0 1.1.6 2.3.6 1.7 0 3.5-1.3 3.5-3.5 0-2.8-2.6-5-5.8-5z"/>
      </svg>
      {{ section.settings.brand_name }}
    </a>

    {%- if section.settings.menu != blank -%}
      <nav aria-label="Main navigation">
        <ul class="pawely-header__nav">
          {%- for link in linklists[section.settings.menu].links -%}
            <li>
              <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="pawely-header__actions">
      <a href="{{ routes.search_url }}" class="pawely-header__action-link" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="pawely-header__action-link" aria-label="Cart{% if cart.item_count > 0 %} ({{ cart.item_count }} items){% endif %}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="pawely-header__cart-badge" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Pawely Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Pawely"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
