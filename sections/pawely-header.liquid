<header class="w-full bg-brand-cream border-b border-stone-200/60 sticky top-0 z-50">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
<!-- Brand Logo -->
<a class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-brand-dark hover:opacity-90 transition" href="{{ routes.root_url }}">
<svg class="w-6 h-6 fill-brand-dark" viewBox="0 0 24 24">
<circle cx="7" cy="8.5" r="2"></circle>
<circle cx="17" cy="8.5" r="2"></circle>
<circle cx="10.5" cy="5" r="2"></circle>
<circle cx="13.5" cy="5" r="2"></circle>
<path d="M12 11.5c-3.2 0-5.8 2.2-5.8 5 0 2.2 1.8 3.5 3.5 3.5 1.2 0 1.9-.6 2.3-.6.4 0 1.1.6 2.3.6 1.7 0 3.5-1.3 3.5-3.5 0-2.8-2.6-5-5.8-5z"></path>
</svg>
<span class="">{{ section.settings.brand_name }}</span>
</a>
<!-- Center Nav Links -->
<nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-stone-700">
<a class="hover:text-brand-green transition" href="#product-purchase">Shop</a>
<a class="hover:text-brand-green transition" href="#story">Our Story</a>
<a class="hover:text-brand-green transition" href="#faq">FAQ</a>
</nav>
<!-- Right Action Icons -->
<div class="flex items-center space-x-5 text-stone-800">
<a aria-label="Search" class="hover:text-brand-green transition" href="{{ routes.search_url }}">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<path d="M21 21l-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</a>
<a aria-label="Shopping Cart" class="hover:text-brand-green transition relative" href="{{ routes.cart_url }}">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
{% if cart.item_count > 0 %}
  <span class="absolute -top-1.5 -right-1.5 bg-brand-green text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center">{{ cart.item_count }}</span>
{% endif %}
</a>
</div>
</div>
</header>

{% schema %}
{
  "name": "Pawely Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Pawely"
    }
  ]
}
{% endschema %}
